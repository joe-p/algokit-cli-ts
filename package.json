{
  "name": "algokit-cli-ts",
  "version": "0.1.0",
  "description": "TypeScript port of the AlgoKit CLI (localnet and goal commands)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "algokit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@inquirer/select": "^5.2.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
